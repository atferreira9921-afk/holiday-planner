# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── AI ────────────────────────────────────────────────────────────────────────
# Get this from: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Flights (SerpApi — Google Flights) ───────────────────────────────────────
# Get this from: serpapi.com → Dashboard → API Key
SERPAPI_KEY=

# ─── Internal service auth ─────────────────────────────────────────────────────
# A random secret shared between Next.js and FastAPI (generate with: openssl rand -hex 32)
FASTAPI_SECRET=change-me-to-a-random-secret

# ─── Service URLs ──────────────────────────────────────────────────────────────
# Local dev
FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

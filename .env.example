# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── AI ────────────────────────────────────────────────────────────────────────
# Set to "false" to disable all AI features (suggestions, smart packing, receipt scanner).
# The app remains fully usable without AI. Defaults to enabled.
NEXT_PUBLIC_AI_ENABLED=true
# Standard Anthropic key (console.anthropic.com) OR corporate proxy key
ANTHROPIC_API_KEY=sk-ant-...
# Optional: set to a custom proxy base URL (e.g. https://your-proxy.azurewebsites.net/api/anthropic)
ANTHROPIC_BASE_URL=

# ─── Flights (SerpApi — Google Flights) ───────────────────────────────────────
# Get this from: serpapi.com → Dashboard → API Key
SERPAPI_KEY=

# ─── Internal service auth ─────────────────────────────────────────────────────
# A random secret shared between Next.js and FastAPI (generate with: openssl rand -hex 32)
FASTAPI_SECRET=change-me-to-a-random-secret

# ─── Service URLs ──────────────────────────────────────────────────────────────
# Local dev
FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
